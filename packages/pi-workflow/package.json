{
  "name": "@pi-workflow/core",
  "version": "1.0.0",
  "private": true,
  "description": "Core runtime, DSL, state model, and host contracts for Pi Workflow.",
  "license": "MIT",
  "author": "skybluefeet <yakun1593@163.com>",
  "homepage": "https://github.com/SkyBlueFeet/pi-workflow",
  "repository": {
    "type": "git",
    "url": "https://github.com/SkyBlueFeet/pi-workflow.git",
    "directory": "packages/pi-workflow"
  },
  "bugs": {
    "url": "https://github.com/SkyBlueFeet/pi-workflow/issues"
  },
  "keywords": [
    "workflow",
    "orchestration",
    "dsl",
    "runtime",
    "agent"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./adapters/pi": {
      "types": "./dist/adapters/pi/index.d.ts",
      "import": "./dist/adapters/pi/index.js"
    },
    "./config/*": {
      "types": "./dist/config/*.d.ts",
      "import": "./dist/config/*.js"
    },
    "./packages/*": {
      "types": "./dist/packages/*.d.ts",
      "import": "./dist/packages/*.js"
    },
    "./agents/*": {
      "types": "./dist/agents/*.d.ts",
      "import": "./dist/agents/*.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "lint": "eslint \"src/**/*.ts\""
  },
  "devDependencies": {
    "typescript": "^5.8.0",
    "vitest": "^3.1.0"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "^0.75.5",
    "@earendil-works/pi-ai": "^0.75.5",
    "@earendil-works/pi-coding-agent": "^0.75.5",
    "@pi-workflow/pi-package-adapter": "*",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "smol-toml": "^1.6.1"
  }
}
