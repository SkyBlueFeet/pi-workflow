{
  "id": "all-node-types",
  "version": "1.0",
  "title": "All Node Types Test Workflow",
  "entry": "init",
  "nodes": [
    {
      "id": "init",
      "title": "1-初始化 (manual)",
      "executor": { "type": "manual" },
      "inputs": {
        "data": { "from": "literal", "value": "name: Alice, age: 30" },
        "items": { "from": "literal", "value": ["x", "y", "z"] }
      },
      "output": { "to": "initResult", "mergeStrategy": "replace" }
    },
    {
      "id": "decide",
      "title": "2-条件判断 (if)",
      "executor": { "type": "if" },
      "dependsOn": ["init"],
      "children": ["branch-body"],
      "control": {
        "condition": { "from": "literal", "value": true }
      }
    },
    {
      "id": "branch-body",
      "title": "3-条件分支体 (manual)",
      "executor": { "type": "manual" },
      "dependsOn": ["init"],
      "inputs": {
        "msg": { "from": "literal", "value": "条件通过" }
      },
      "output": { "to": "branchResult", "mergeStrategy": "replace" }
    },
    {
      "id": "fan-out",
      "title": "4-并行分发 (parallel)",
      "executor": { "type": "parallel" },
      "dependsOn": ["branch-body"],
      "children": ["task-http", "task-extract"]
    },
    {
      "id": "task-http",
      "title": "5-HTTP请求 (http)",
      "executor": { "type": "http" },
      "dependsOn": ["branch-body"],
      "inputs": {
        "url": { "from": "literal", "value": "https://example.test/all-node-types" },
        "method": { "from": "literal", "value": "GET" },
        "timeoutMs": { "from": "literal", "value": 10000 }
      },
      "output": { "to": "httpResult", "mergeStrategy": "replace" }
    },
    {
      "id": "task-extract",
      "title": "6-数据提取 (extractor)",
      "executor": {
        "type": "extractor",
        "config": {
          "sourceType": "text",
          "mode": "extract",
          "fields": ["name", "age"]
        }
      },
      "dependsOn": ["branch-body"],
      "inputs": {
        "input": { "from": "node.output", "nodeId": "init", "path": "data" }
      },
      "output": { "to": "extractResult", "mergeStrategy": "replace" }
    },
    {
      "id": "call-tool",
      "title": "7-工具调用 (tool)",
      "executor": { "type": "tool" },
      "dependsOn": ["task-http"],
      "inputs": {
        "toolName": { "from": "literal", "value": "echo" },
        "params": {
          "from": "literal",
          "value": {
            "message": "hello from tool node",
            "source": "all-node-types"
          }
        }
      },
      "output": { "to": "toolResult", "mergeStrategy": "replace" }
    },
    {
      "id": "ai-agent",
      "title": "8-AI智能体 (agent)",
      "executor": {
        "type": "agent",
        "config": {
          "agentId": "all-node-types-agent"
        }
      },
      "dependsOn": ["task-extract"],
      "inputs": {
        "user_prompt": {
          "from": "node.output",
          "nodeId": "task-extract",
          "path": "data"
        }
      },
      "output": { "to": "agentResult", "mergeStrategy": "replace" }
    },
    {
      "id": "iterate",
      "title": "9-循环迭代 (loop)",
      "executor": { "type": "loop" },
      "dependsOn": ["call-tool", "ai-agent"],
      "children": ["loop-body"],
      "control": {
        "loopOver": { "from": "node.output", "nodeId": "init", "path": "items" },
        "itemName": "item"
      }
    },
    {
      "id": "loop-body",
      "title": "10-循环体 (manual)",
      "executor": { "type": "manual" },
      "dependsOn": ["call-tool", "ai-agent"],
      "inputs": {
        "current": { "from": "frame.local", "path": "item" }
      },
      "output": { "to": "loopResult", "mergeStrategy": "append-array" }
    },
    {
      "id": "sub",
      "title": "11-子工作流 (workflow)",
      "executor": { "type": "workflow" },
      "dependsOn": ["loop-body"],
      "children": ["sub-step"]
    },
    {
      "id": "sub-step",
      "title": "12-子步骤 (manual)",
      "executor": { "type": "manual" },
      "dependsOn": ["iterate"],
      "inputs": {
        "summary": { "from": "literal", "value": "子工作流完成" }
      },
      "output": { "to": "subResult", "mergeStrategy": "replace" }
    },
    {
      "id": "final",
      "title": "13-最终输出 (return)",
      "executor": { "type": "return" },
      "dependsOn": ["sub-step"],
      "inputs": {
        "manual": { "from": "context", "path": "initResult" },
        "branch": { "from": "context", "path": "branchResult" },
        "httpStatus": { "from": "context", "path": "httpResult.status" },
        "extract": { "from": "context", "path": "extractResult.data" },
        "tool": { "from": "context", "path": "toolResult" },
        "agent": { "from": "context", "path": "agentResult" },
        "loop": { "from": "context", "path": "loopResult" },
        "sub": { "from": "context", "path": "subResult" }
      },
      "output": { "to": "final", "mergeStrategy": "replace" }
    }
  ]
}
