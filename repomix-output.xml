      dependsOn: [], inputBindings: {},
      output: { to: "result", mergeStrategy: "replace" },
    };
    const context: ExecutionContext = {
      runId: "test-run",
      nodeId: "agent1",
      nodeInput: { user_prompt: "Say hello" },
